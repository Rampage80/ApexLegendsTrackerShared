<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>ApexLegendsTracker.Shared</PackageId>
    <Version>1.0.0</Version>
    <Description>Shared player-lookup contract (DTOs and interface) consumed by the ApexLegendsTracker Web and Service repos.</Description>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\LocalFeed</PackageOutputPath>
  </PropertyGroup>

</Project>
