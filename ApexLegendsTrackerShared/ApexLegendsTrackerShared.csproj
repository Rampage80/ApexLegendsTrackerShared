<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
  <TargetFramework>net10.0</TargetFramework>
  <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>ApexLegendsTrackerShared</PackageId>
  <Version>1.1.0</Version>
  <Authors>Rampage80</Authors>
  <Description>Shared player-lookup contract (DTOs and interface) consumed by the ApexLegendsTracker Web and Service repos.</Description>
  <RepositoryUrl>https://github.com/Rampage80/ApexLegendsTrackerShared</RepositoryUrl>
  <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  <PackageOutputPath>$(MSBuildThisFileDirectory)..\LocalFeed</PackageOutputPath>
</PropertyGroup>

</Project>
